# --- Required ---------------------------------------------------------------
# Postgres connection string. Use a managed Postgres (Neon, Supabase, RDS…)
# in production with TLS (append ?sslmode=require).
# Runtime connection. On Supabase: the Transaction pooler URL (port 6543)
# with ?pgbouncer=true&connection_limit=1. See docs/DEPLOYMENT.md.
DATABASE_URL="postgresql://user:password@localhost:5432/growthos?schema=public"
# Migration connection. On Supabase: the Session pooler URL (port 5432).
# Locally it can equal DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/growthos?schema=public"

# --- First-run setup on a hosted deployment ----------------------------------
# Enables /setup (founder account creation) while the database has no users.
# At least 24 characters. Remove after setup.
SETUP_TOKEN=

# --- Seeding (only read by `npm run db:seed`) --------------------------------
# Creates the founder account on first seed. If SEED_FOUNDER_PASSWORD is empty
# a random password is generated and printed once.
SEED_FOUNDER_EMAIL=
SEED_FOUNDER_NAME=
SEED_FOUNDER_PASSWORD=
# Optional: programme week-1 date (YYYY-MM-DD). Editable in the app later.
SEED_PROGRAMME_START=
# Set to "true" ONLY for demo/dev databases: adds a synthetic 10-operator
# cohort, demo admin + 2 operator logins, and illustrative results. Never on a
# database that will hold real operator data.
SEED_DEMO=false
SEED_DEMO_PASSWORD=

# --- Optional ----------------------------------------------------------------
# Destination-intelligence modules only (Scenario Engine LLM mode, AI
# Discovery runner). The Growth OS itself makes no LLM calls.
ANTHROPIC_API_KEY=

# Tests: a separate, disposable database (name must contain "test").
TEST_DATABASE_URL=

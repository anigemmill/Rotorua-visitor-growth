DATABASE_URL="postgresql://user:password@localhost:5432/tourism_platform?schema=public"

# Integration credential encryption (AES-256-GCM). Comma-separated
# "<version>:<base64 32-byte key>" pairs; the highest version encrypts, all
# listed versions decrypt (rotation). Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production, source this from your secret manager / KMS, never a file in git.
CREDENTIAL_ENCRYPTION_KEYS=

# Public origin of the app (email links; OAuth redirect URIs from Phase 2).
APP_URL=http://localhost:3000

# Email: "file" writes messages to EMAIL_FILE_DIR (development); production
# uses "ses" with credentials from the runtime IAM role (docs/platform/HOSTING.md).
EMAIL_TRANSPORT=file
EMAIL_FILE_DIR=.email-outbox
# EMAIL_FROM="Tourism Intelligence <no-reply@your-domain>"
# SES_REGION=ap-southeast-2

# Optional: enables the legacy destination dashboard's Scenario Engine LLM
# mode and AI Discovery runner. Server-side only.
ANTHROPIC_API_KEY=

# Tests use a separate database whose name must contain "test".
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/tourism_platform_test?schema=public"

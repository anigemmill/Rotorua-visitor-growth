// Rotorua Visitor Growth & Flow Intelligence — data model
// See docs/ARCHITECTURE.md §1-2 for the design rationale.
//
// Governance rule enforced by this schema: every observation / derived-
// intelligence row carries source, dataType, timestamp, geography, time
// period, confidence and access level. There is no fact table without them.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Governance enums
// ---------------------------------------------------------------------------

enum AccessLevel {
  PUBLIC // openly published data (e.g. Stats NZ, RotoruaNZ public reports)
  PARTNER // shared with the DMO / destination-management partners
  PRIVATE_BUSINESS // a single business's own data — never shown to competitors
  AGGREGATED // rolled up from private data such that no single business is identifiable
  MODEL_INFERENCE // generated by an engine, not observed directly
}

enum Confidence {
  VERIFIED // primary source, directly reported
  HIGH // reputable secondary source or well-sampled survey
  MEDIUM // partial coverage, small sample, or dated
  LOW // indicative only
  MODELLED // derived/inferred by an engine — never upgraded to VERIFIED
}

enum Role {
  PUBLIC
  PARTNER
  BUSINESS
  ADMIN
}

enum ConnectorStatus {
  CONNECTED
  NOT_CONNECTED
  MANUAL_IMPORT_ONLY
  ERROR
}

// ---------------------------------------------------------------------------
// Reference: destinations (scalability — Rotorua is the first, not the only)
// ---------------------------------------------------------------------------

model Destination {
  id        String   @id @default(cuid())
  slug      String   @unique // e.g. "rotorua"
  name      String
  country   String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  dataSources             DataSource[]
  visitorMetrics          VisitorMetric[]
  accommodationMetrics    AccommodationMetric[]
  accommodationProperties AccommodationProperty[]
  experiences             Experience[]
  demandSignals           DemandSignal[]
  weatherObservations     WeatherObservation[]
  weatherForecasts        WeatherForecast[]
  publicHolidays          PublicHoliday[]
  transportDisruptions    TransportDisruption[]
  capacityRecords         CapacityRecord[]
  trackedPrompts          TrackedPrompt[]
  aiVisibilityChecks      AIVisibilityCheck[]
  destinationEvents       DestinationEvent[]
  businesses              Business[]
  marketOpportunities     MarketOpportunity[]
  productGaps             ProductGap[]
  partnerships            Partnership[]
  campaigns               Campaign[]
  itineraries             Itinerary[]
  scenarioQueries         ScenarioQuery[]
  importBatches           ImportBatch[]
}

// ---------------------------------------------------------------------------
// Governance registry
// ---------------------------------------------------------------------------

model DataSource {
  id                 String          @id @default(cuid())
  destinationId      String
  destination        Destination     @relation(fields: [destinationId], references: [id])
  name               String // e.g. "RotoruaNZ Visitor Spend Report", "Open-Meteo"
  organisation       String // who publishes/owns it
  dataType           String // e.g. "visitor spend", "weather forecast"
  licence            String? // usage terms, if known
  defaultAccessLevel AccessLevel     @default(PUBLIC)
  connectorStatus    ConnectorStatus @default(MANUAL_IMPORT_ONLY)
  connectorKey       String? // internal key of the connector module, if CONNECTED
  url                String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  importBatches        ImportBatch[]
  visitorMetrics       VisitorMetric[]
  accommodationMetrics AccommodationMetric[]
  experiences          Experience[]
  demandSignals        DemandSignal[]
  weatherObservations  WeatherObservation[]
  weatherForecasts     WeatherForecast[]
  publicHolidays       PublicHoliday[]
  transportDisruptions TransportDisruption[]
  capacityRecords      CapacityRecord[]
  aiVisibilityChecks   AIVisibilityCheck[]
  destinationEvents    DestinationEvent[]

  @@unique([destinationId, name])
}

// Every manual CSV upload — the audit trail behind manual-import data.
model ImportBatch {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  dataSourceId  String
  dataSource    DataSource  @relation(fields: [dataSourceId], references: [id])
  targetTable   String // which observation table this batch loaded
  uploadedBy    String // email/id of the operator who imported it
  fileName      String
  rowCount      Int
  rejectedCount Int         @default(0)
  geography     String
  periodStart   DateTime
  periodEnd     DateTime
  confidence    Confidence
  accessLevel   AccessLevel
  notes         String?
  createdAt     DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// VISITORS
// ---------------------------------------------------------------------------

model VisitorMetric {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource  @relation(fields: [sourceId], references: [id])

  metric String // e.g. "visitor_volume", "avg_length_of_stay_nights", "total_spend_nzd"
  value  Float
  unit   String // e.g. "count", "nights", "nzd"

  originMarket    String? // e.g. "Australia", "Domestic - Auckland", null = all markets
  isInternational Boolean?
  visitorPurpose  String? // e.g. "leisure", "business", "VFR"

  geography   String // e.g. "Rotorua District"
  periodStart DateTime
  periodEnd   DateTime
  confidence  Confidence
  accessLevel AccessLevel

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([destinationId, metric, periodStart])
}

// ---------------------------------------------------------------------------
// ACCOMMODATION
// ---------------------------------------------------------------------------

model AccommodationProperty {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  name          String
  type          String // e.g. "hotel", "motel", "holiday_park", "Airbnb"
  geography     String
  roomCount     Int?
  businessId    String?
  business      Business?   @relation(fields: [businessId], references: [id])
  createdAt     DateTime    @default(now())

  metrics AccommodationMetric[]
}

model AccommodationMetric {
  id            String                 @id @default(cuid())
  destinationId String
  destination   Destination            @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource             @relation(fields: [sourceId], references: [id])
  propertyId    String?
  property      AccommodationProperty? @relation(fields: [propertyId], references: [id])

  metric String // e.g. "occupancy_rate", "room_nights_sold", "forward_bookings"
  value  Float
  unit   String

  accommodationType String? // used when propertyId is null (aggregated by type)
  geography         String
  periodStart       DateTime
  periodEnd         DateTime
  confidence        Confidence
  accessLevel       AccessLevel

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([destinationId, metric, periodStart])
}

// ---------------------------------------------------------------------------
// EXPERIENCES
// ---------------------------------------------------------------------------

model ExperienceCategory {
  id          String       @id @default(cuid())
  slug        String       @unique // e.g. "geothermal", "maori-culture", "adventure"
  name        String
  description String?
  experiences Experience[]
}

model Experience {
  id            String             @id @default(cuid())
  destinationId String
  destination   Destination        @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource         @relation(fields: [sourceId], references: [id])
  categoryId    String
  category      ExperienceCategory @relation(fields: [categoryId], references: [id])
  businessId    String?
  business      Business?          @relation(fields: [businessId], references: [id])

  name        String
  description String?
  geography   String
  isBookable  Boolean @default(false)
  websiteUrl  String?

  accessLevel AccessLevel @default(PUBLIC)
  confidence  Confidence  @default(VERIFIED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  capacityRecords CapacityRecord[]

  @@index([destinationId, categoryId])
}

// ---------------------------------------------------------------------------
// DEMAND
// ---------------------------------------------------------------------------

model DemandSignal {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource  @relation(fields: [sourceId], references: [id])

  signalType String // e.g. "search_trend", "ai_travel_query", "social_mention", "booking_lead"
  topic      String // e.g. "geothermal spa", "mountain biking Rotorua"
  value      Float // index/volume score as reported by the source — never invented
  unit       String

  geography   String // origin market geography, or "global"
  periodStart DateTime
  periodEnd   DateTime
  confidence  Confidence
  accessLevel AccessLevel

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([destinationId, signalType, periodStart])
}

// ---------------------------------------------------------------------------
// AI DESTINATION DISCOVERY ENGINE
// ---------------------------------------------------------------------------

model TrackedPrompt {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  prompt        String // e.g. "Best things to do in Rotorua"
  category      String // e.g. "general", "cultural", "adventure", "wellness", "itinerary"
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  checks AIVisibilityCheck[]
}

model AIVisibilityCheck {
  id            String        @id @default(cuid())
  destinationId String
  destination   Destination   @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource    @relation(fields: [sourceId], references: [id])
  promptId      String
  prompt        TrackedPrompt @relation(fields: [promptId], references: [id])

  aiSystem               String // e.g. "claude-sonnet-5", "gpt-4o" — whatever was actually called
  rawResponse            String // full response text, for audit
  destinationMentioned   Boolean
  mentionPosition        Int? // 1 = first recommendation mentioned, null if not mentioned
  experiencesRecommended String[] // extracted experience names, as the model stated them
  competitorsMentioned   String[]
  citedSources           String[]
  factualIssues          String[] // anything the reviewer flags as incorrect — populated by a human review pass, not invented

  confidence  Confidence  @default(MODELLED)
  accessLevel AccessLevel @default(PARTNER)

  runAt     DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([destinationId, promptId, runAt])
}

// ---------------------------------------------------------------------------
// CONDITIONS
// ---------------------------------------------------------------------------

model WeatherObservation {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource  @relation(fields: [sourceId], references: [id])

  temperatureC    Float
  conditionCode   String // provider's own weather code, stored as-is
  windSpeedKmh    Float?
  precipitationMm Float?

  geography   String
  observedAt  DateTime
  confidence  Confidence  @default(VERIFIED)
  accessLevel AccessLevel @default(PUBLIC)
  createdAt   DateTime    @default(now())

  @@index([destinationId, observedAt])
}

model WeatherForecast {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource  @relation(fields: [sourceId], references: [id])

  forDate                  DateTime
  temperatureMinC          Float
  temperatureMaxC          Float
  conditionCode            String
  precipitationProbability Float?

  geography   String
  issuedAt    DateTime
  confidence  Confidence  @default(HIGH)
  accessLevel AccessLevel @default(PUBLIC)
  createdAt   DateTime    @default(now())

  @@index([destinationId, forDate])
}

model PublicHoliday {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource  @relation(fields: [sourceId], references: [id])

  name              String
  date              DateTime
  regional          Boolean  @default(false)
  countiesOrRegions String[]

  accessLevel AccessLevel @default(PUBLIC)
  confidence  Confidence  @default(VERIFIED)
  createdAt   DateTime    @default(now())

  @@index([destinationId, date])
}

model TransportDisruption {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource  @relation(fields: [sourceId], references: [id])

  mode        String // e.g. "road", "air", "rail"
  description String
  geography   String
  startsAt    DateTime
  endsAt      DateTime?

  confidence  Confidence  @default(HIGH)
  accessLevel AccessLevel @default(PUBLIC)
  createdAt   DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// CAPACITY
// ---------------------------------------------------------------------------

model CapacityRecord {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource  @relation(fields: [sourceId], references: [id])
  experienceId  String?
  experience    Experience? @relation(fields: [experienceId], references: [id])

  capacityType      String // "attraction" | "accommodation" | "transport" | "event"
  totalCapacity     Float?
  availableCapacity Float?
  unit              String // e.g. "visitors/day", "rooms", "seats"
  verifiedAvailable Boolean @default(false) // must be true before an engine may present this as currently bookable

  geography   String
  periodStart DateTime
  periodEnd   DateTime
  confidence  Confidence
  accessLevel AccessLevel

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([destinationId, capacityType, periodStart])
}

// ---------------------------------------------------------------------------
// EVENTS
// ---------------------------------------------------------------------------

model DestinationEvent {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource  @relation(fields: [sourceId], references: [id])

  name               String
  category           String // e.g. "festival", "sport", "conference", "cultural"
  geography          String
  startsAt           DateTime
  endsAt             DateTime
  expectedAttendance Int?

  confidence  Confidence  @default(HIGH)
  accessLevel AccessLevel @default(PUBLIC)
  createdAt   DateTime    @default(now())

  @@index([destinationId, startsAt])
}

// ---------------------------------------------------------------------------
// BUSINESS ECOSYSTEM
// ---------------------------------------------------------------------------

model Business {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  name          String
  category      String
  contactEmail  String?
  createdAt     DateTime    @default(now())

  experiences             Experience[]
  accommodationProperties AccommodationProperty[]
  contributions           BusinessContribution[]
}

// Anything a business opts to share (capacity, offers, new products) — always
// PRIVATE_BUSINESS unless the business explicitly marks it for aggregation.
model BusinessContribution {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  contributionType String // "capacity" | "new_product" | "event" | "offer" | "availability"
  payload          Json // shape depends on contributionType — validated at the API layer
  accessLevel      AccessLevel @default(PRIVATE_BUSINESS)

  submittedBy String
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// DERIVED INTELLIGENCE — every row must cite the evidence it used and, where
// evidence is incomplete, what's still needed (dataNeeded).
// ---------------------------------------------------------------------------

model MarketOpportunity {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  market             String
  travellerType      String
  demandSignal       String
  currentPerformance String
  competition        String
  productFit         String
  gap                String
  potential          String
  risks              String
  dataNeeded         String[]

  evidenceRefs Json // { visitorMetricIds: [...], demandSignalIds: [...] }
  confidence   Confidence  @default(MODELLED)
  accessLevel  AccessLevel @default(PARTNER)
  createdAt    DateTime    @default(now())
}

model ProductGap {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  targetVisitor            String
  demandSignal             String
  currentSupply            String
  gap                      String
  potentialProduct         String
  potentialPartners        String[]
  seasonality              String
  competition              String
  commercialConsiderations String
  risks                    String
  dataNeeded               String[]

  evidenceRefs Json
  confidence   Confidence  @default(MODELLED)
  accessLevel  AccessLevel @default(PARTNER)
  createdAt    DateTime    @default(now())
}

model Partnership {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  name          String
  participants  String[]
  rationale     String
  targetOutcome String // e.g. "longer stays", "off-season demand"
  evidenceRefs  Json
  confidence    Confidence  @default(MODELLED)
  accessLevel   AccessLevel @default(PARTNER)
  createdAt     DateTime    @default(now())
}

model Itinerary {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  title         String
  visitorType   String
  nights        Int
  interests     String[]
  itineraryJson Json // day-by-day plan referencing only verified, bookable Experience rows
  optimisedFor  String[] // e.g. ["length_of_stay", "geographic_distribution"]
  createdAt     DateTime @default(now())
}

model Campaign {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  objective   String
  audience    String
  evidence    String
  message     String
  product     String
  channel     String
  cta         String
  measurement String

  status    String   @default("draft") // draft | needs_authorisation | approved | live
  createdAt DateTime @default(now())
}

// Scenario Engine answers — structured so FACT / EVIDENCE / INFERENCE /
// HYPOTHESIS / RECOMMENDATION are never collapsed into one undifferentiated blob.
model ScenarioQuery {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  question String
  askedBy  String

  facts            Json
  evidence         Json
  inferences       Json
  hypotheses       Json
  recommendations  Json
  insufficientData String[] // what's missing, if anything

  llmAssisted Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ===========================================================================
// LICENSED PLATFORM FOUNDATION (Phase 1)
// See docs/platform/ARCHITECTURE.md and docs/platform/DATA_MODEL.md.
//
// Tenant boundary: Organization. Every tenant-owned row carries a non-null
// organizationId and is only read/written through the tenant-scoped client
// in src/lib/platform/tenant-db.ts, which injects that filter. Platform
// staff tooling (src/lib/platform/admin.ts) is the only cross-tenant path
// and is audited.
// ===========================================================================

enum PlatformRole {
  NONE // ordinary customer user
  SUPPORT // platform staff — read-only cross-tenant access
  SUPER_ADMIN // platform staff — may manage licences, products and organisations
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum OrganizationStatus {
  ACTIVE
  DELETION_REQUESTED
}

enum OnboardingStage {
  BUSINESS_PROFILE
  BUSINESS_KNOWLEDGE
  INTEGRATIONS
  VALIDATION
  ACTIVATION
  COMPLETE
}

enum LicenseStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum BillingInterval {
  MONTH
  YEAR
  CUSTOM
}

enum IntegrationStatus {
  PENDING // configured, not yet validated
  CONNECTED
  ERROR
  REVOKED // disconnected by the customer or revoked at the provider
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique // stored lower-cased
  name            String
  passwordHash    String
  platformRole    PlatformRole @default(NONE)
  emailVerifiedAt DateTime?
  disabledAt      DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  sessions    AuthSession[]
  memberships Membership[]
}

// Opaque, server-side sessions. Only the SHA-256 of the cookie token is
// stored, so a database read does not yield usable session cookies.
model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Organization {
  id                  String             @id @default(cuid())
  slug                String             @unique
  name                String
  status              OrganizationStatus @default(ACTIVE)
  onboardingStage     OnboardingStage    @default(BUSINESS_PROFILE)
  activatedAt         DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  memberships  Membership[]
  licenses     License[]
  profile      BusinessProfile?
  brands       Brand[]
  integrations IntegrationConnection[]
  auditEvents  AuditEvent[]
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MembershipRole
  createdAt      DateTime       @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalogue & licensing. Commercial rules (prices, limits, features) live in
// data, not code, so they can change without a release.
// ---------------------------------------------------------------------------

model Product {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "tourism-intelligence"
  name        String
  tagline     String
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions ProductVersion[]
  plans    Plan[]
  licenses License[]
}

model ProductVersion {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  version      String // semver of the ecosystem definition
  releaseNotes String
  isCurrent    Boolean  @default(false)
  releasedAt   DateTime @default(now())

  @@unique([productId, version])
}

model Plan {
  id              String          @id @default(cuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  key             String          @unique // e.g. "tourism-pilot"
  name            String
  description     String
  billingInterval BillingInterval
  priceCents      Int? // null = price on request / not yet set
  currency        String          @default("NZD")
  priceNote       String? // shown beside the price, e.g. "per month, excl. GST"
  isPublic        Boolean         @default(true) // shown in the self-serve catalogue
  selfServeTrial  Boolean         @default(false) // customer may start a trial without staff
  trialDays       Int?
  entitlements    Json // validated by src/lib/platform/entitlements.ts (EntitlementsSchema)
  active          Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  licenses License[]
}

model License {
  id                     String        @id @default(cuid())
  organizationId         String
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId              String
  product                Product       @relation(fields: [productId], references: [id])
  planId                 String
  plan                   Plan          @relation(fields: [planId], references: [id])
  status                 LicenseStatus
  startsAt               DateTime      @default(now())
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  graceDays              Int           @default(7)
  cancelledAt            DateTime?
  entitlementOverrides   Json? // partial EntitlementsSchema, merged over the plan's
  // Billing-provider references (Stripe or invoicing). Null until billing is wired.
  billingProvider        String?
  externalCustomerId     String?
  externalSubscriptionId String?
  notes                  String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@unique([organizationId, productId])
}

// ---------------------------------------------------------------------------
// Onboarding: business profile (stage 1) and business knowledge (stage 2).
// Customer-specific only — universal platform instructions and industry
// knowledge live in code/config, never in these rows.
// ---------------------------------------------------------------------------

model BusinessProfile {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Stage 1 — business profile
  businessName       String
  website            String?
  country            String?
  timeZone           String?
  businessType       String?
  products           String[]
  targetAudiences    String[]
  mainMarkets        String[]
  objectives         String[]
  seasonalPriorities String?
  competitors        String[]
  marketingChannels  String[]
  kpis               String[]
  constraints        String?

  // Stage 2 — business knowledge
  positioning         String?
  approvedMessaging   String?
  toneOfVoice         String?
  uniqueSellingPoints String[]
  pricingNotes        String?
  brandRestrictions   String?
  culturalGuidelines  String?

  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Brand {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  website        String?
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
}

// ---------------------------------------------------------------------------
// Integration connections. Provider definitions live in code
// (src/lib/integrations/registry.ts); this row is one tenant's connection.
// Credentials are AES-256-GCM encrypted with the row identity as AAD and are
// never sent to the browser or to a model.
// ---------------------------------------------------------------------------

model IntegrationConnection {
  id                    String            @id @default(cuid())
  organizationId        String
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerKey           String
  status                IntegrationStatus @default(PENDING)
  externalAccountId     String // provider account/property id, or the domain for the website connector
  externalAccountName   String?
  config                Json?
  scopesGranted         String[]
  credentialsCiphertext String?
  connectedById         String?
  connectedAt           DateTime?
  lastSyncAt            DateTime?
  lastSuccessfulSyncAt  DateTime?
  lastErrorAt           DateTime?
  lastErrorMessage      String?
  disconnectedAt        DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([organizationId, providerKey, externalAccountId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Security & operations
// ---------------------------------------------------------------------------

model AuditEvent {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUserId    String?
  actorEmail     String? // denormalised so the trail survives user deletion
  action         String // e.g. "auth.login", "license.granted", "integration.disconnected"
  targetType     String?
  targetId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([action, createdAt])
}

// Fixed-window counters for rate limiting (login attempts etc.). Postgres-
// backed so limits hold across server instances without extra infra.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int
}
